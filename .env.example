# Savespace works fully with ZERO connectors. Everything below is optional.
# Copy to .env (never committed) only if you want the Google connectors.
# See MISSING_CREDENTIALS.md and SETUP_GUIDE.md for how to get these.

# Google OAuth "Desktop app" client (Gmail drafts, Drive metadata, Calendar events; read-only scopes)
SAVESPACE_GOOGLE_CLIENT_ID=
SAVESPACE_GOOGLE_CLIENT_SECRET=
