{
  "name": "waypoint",
  "productName": "Waypoint",
  "version": "0.1.0",
  "private": true,
  "description": "Work-continuity for macOS: checkpoint your working state and resume it later. Open-only, local-only.",
  "main": "./out/main/index.js",
  "license": "UNLICENSED",
  "author": "Waypoint",
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "dev": "node scripts/fetch-ollama.mjs && node scripts/build-apple-ai.mjs && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "node scripts/fetch-ollama.mjs && node scripts/build-apple-ai.mjs && env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:unit": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "electron-vite build && env -u ELECTRON_RUN_AS_NODE playwright test",
    "db:generate": "drizzle-kit generate",
    "audit:safety": "node scripts/safety-audit.mjs",
    "dist": "node scripts/fetch-ollama.mjs && node scripts/build-apple-ai.mjs && npm run build && electron-builder --mac dmg --arm64",
    "postinstall": "electron-builder install-app-deps && node scripts/fetch-ollama.mjs && node scripts/build-apple-ai.mjs",
    "fetch:ollama": "node scripts/fetch-ollama.mjs",
    "build:apple-ai": "node scripts/build-apple-ai.mjs"
  },
  "dependencies": {
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^14.12.0",
    "fuse.js": "^7.5.0",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.71.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "electron@45.3.0": true,
    "electron-winstaller": false
  }
}
